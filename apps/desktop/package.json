{
  "name": "@notsai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "notsAI desktop shell (Tauri 2 + React + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "TAURI_APP_PATH=../../crates/notsai-tauri tauri"
  },
  "dependencies": {
    "@notsai/api-client": "workspace:*",
    "@notsai/shared-types": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}